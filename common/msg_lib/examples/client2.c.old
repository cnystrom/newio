#include <stdio.h>
#include <stdlib.h>
#include "nio_log.h"
#include "sock_lib.h"
#include "ssh2_lib.h"
#include "msg_lib.h"

#define PORT (22)
#define SUBSYSTEM_KEY "msg_lib_test"

#define USERNAME "CHANGEME"
#define PASSWD "CHANGEME"

#define SEND_STRING (0)

static int done = 0;

void do_data_in(void)
{
	msg_num_t mn;
	char string[12];

	if (done) {
		return;
	}

	mn = msg_get_num();

	if (mn == MSG_STOP) {
		// server says stop: process no more messages

		nio_log_print("do_data_in(): got MSG_STOP\n");
		done = 1;
		return;
	}

	while (mn > MSG_BUF_EMPTY) {

		if (SEND_STRING == mn) {
			msg_unpack_string(string);

			printf("IN> |%s|\n", string);
			fflush(stdout);
		} else {
			fprintf(stderr,
				"do_data_in(): bad function number: %d\n",
				mn);
		}

		mn = msg_get_num();
	}
}

void test_write(const char *s)
{
	msg_set_num(SEND_STRING);	// msg_num
	msg_pack_string(s);

	printf("OUT> |%s|\n", s);
	fflush(stdout);
}

int main(void)
{
	int i, j;
	char string[12];
	SOCKET s;

	nio_log_use_stdout(TRUE);

	s = init_tcp_client("localhost", PORT);

	if (init_session(s, USERNAME, PASSWD) != 0) {
		printf("Login failed.\n");
		close_socket(s);
		return (-1);
	}

	if (request_subsystem(SUBSYSTEM_KEY)) {
		printf("Remote subsystem failed.\n");
		free_session();
		close_socket(s);
		return (-1);
	}

	printf("Remote subsystem succeeded.\n");

	msg_init_ssh_client();

	j = 0;
	for (i = 0; i < 100; i++) {
		sprintf(string, "Test C%d", i);
		test_write(string);

		j++;
		if (j == 10) {
			//      printf("%d\n", i + 1);
			j = 0;
			msg_send();
		}
	}

	nio_log_print("here 1\n");

	msg_stop_ssh_client();

	exit(0);
}
